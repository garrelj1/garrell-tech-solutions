{
  "name": "@gts/design-system",
  "version": "0.1.0",
  "description": "Garrell Tech Solutions design system: brand tokens and the component patterns used on garrellts.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css && cp src/fonts/*.woff2 dist/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.5",
    "@types/react": "^19.0.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.0.5",
    "typescript": "^5.7.3"
  }
}
